cursor_beam 1
cursor_blinking yes
enable_3d true

confirm_os_window_close 0

# ---------------- Font ----------------
font_family JetBrains Nerd Font
bold_font   JetBrains Nerd Font
italic_font JetBrains Nerd Font
bold_italic_font JetBrains Nerd Font
font_size 14

# ---------------- Window ----------------
background_opacity 1.0
window_padding_width 20
