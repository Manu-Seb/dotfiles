-- lua/plugins/lsp.lua (or your lsp config file)
return {
	"neovim/nvim-lspconfig",
	dependencies = {
		-- Core LSP & Installer
		"williamboman/mason.nvim",
		"williamboman/mason-lspconfig.nvim",

		-- Autocompletion Engine & Sources
		"hrsh7th/nvim-cmp",
		"hrsh7th/cmp-buffer",
		"hrsh7th/cmp-path",
		"hrsh7th/cmp-nvim-lsp",
		"hrsh7th/cmp-nvim-lua", -- If you use Lua completion

		-- Snippets Engine & Sources
		"L3MON4D3/LuaSnip",
		"saadparwaiz1/cmp_luasnip", -- Bridge cmp & luasnip
		"rafamadriz/friendly-snippets", -- Collection of snippets

		-- Debugging (DAP)
		"mfussenegger/nvim-dap",
		"WhoIsSethDaniel/mason-tool-installer.nvim", -- Installs DAP adapters via Mason
		"stevearc/conform.nvim", -- Formatter (Prettier!)
		"nvimtools/none-ls.nvim", -- Optional: ESLint diagnostics
	},
	config = function()
		-- Define which filetypes should be auto-formatted on save
		local autoformat_filetypes = { "lua", "rust", "javascript", "typescript", "javascriptreact", "typescriptreact" }
		-- Add other filetypes as needed

		-- Get capabilities for nvim-cmp

		local capabilities = require("cmp_nvim_lsp").default_capabilities()

		-- Setup Mason (LSP/DAP/Linter/Formatter Installer)
		require("mason").setup({})

		-- NEW: conform.nvim (Prettier formatting)
		local conform = require("conform")
		conform.setup({
			formatters_by_ft = {
				javascript = { "prettier" },
				javascriptreact = { "prettier" },
				typescript = { "prettier" },
				typescriptreact = { "prettier" },
				-- Add more filetypes as needed
			},
			format_on_save = {
				timeout_ms = 500,
				lsp_fallback = false, -- NEVER fallback to ts_ls
			},
		})

		-- Setup Mason-LSPConfig Bridge
    require("mason-lspconfig").setup({
      ensure_installed = {
        "html", "cssls", "jsonls", "bashls", "marksman", "jdtls",
        "lua_ls", "intelephense", "ts_ls", "eslint", "pyright", "rust_analyzer",
        "prettier", "eslint_d",  -- ← Add these!
      },
      handlers = {
        function(server_name)
          require("lspconfig")[server_name].setup({
            capabilities = capabilities,
            on_attach = function(client, bufnr)
              -- DISABLE LSP FORMATTING (conform only)
              client.server_capabilities.documentFormattingProvider = false
              client.server_capabilities.documentRangeFormattingProvider = false
            end,
          })
        end,
        lua_ls = function()  -- your custom lua_ls
          require("lspconfig").lua_ls.setup({
            capabilities = capabilities,
            settings = {
              Lua = {
                runtime = { version = "LuaJIT" },
                diagnostics = { globals = { "vim" } },
                workspace = { library = { vim.env.VIMRUNTIME } },
              },
            },
          })
        end,
        rust_analyzer = function()  -- your custom rust_analyzer
          require("lspconfig").rust_analyzer.setup({
            capabilities = capabilities,
            settings = {
              ["rust-analyzer"] = {
                checkOnSave = { command = "clippy" },
              },
            },
          })
        end,
      },
    })

		-- UI Customization for LSP (Borders, Diagnostics)
		vim.lsp.handlers["textDocument/hover"] = vim.lsp.with(vim.lsp.handlers.hover, { border = "rounded" })
		vim.lsp.handlers["textDocument/signatureHelp"] =
			vim.lsp.with(vim.lsp.handlers.signature_help, { border = "rounded" })

		vim.diagnostic.config({
			virtual_text = true, -- Show errors inline
			severity_sort = true,
			float = {
				style = "minimal",
				border = "rounded",
				header = "",
				prefix = "",
			},
			signs = {
				text = {
					[vim.diagnostic.severity.ERROR] = "✘",
					[vim.diagnostic.severity.WARN] = "▲",
					[vim.diagnostic.severity.HINT] = "⚑",
					[vim.diagnostic.severity.INFO] = "»",
				},
			},
			-- update_in_insert = true, -- Update diagnostics in insert mode (can impact performance)
		})

		-- Keymaps and Auto-Formatting on LspAttach
		vim.api.nvim_create_autocmd("LspAttach", {
			group = vim.api.nvim_create_augroup("UserLspConfig", {}), -- Use an augroup
			callback = function(event)
				local opts = { buffer = event.buf, noremap = true, silent = true }
				local client = vim.lsp.get_client_by_id(event.data.client_id)

				-- Standard LSP Keymaps
				vim.keymap.set("n", "K", vim.lsp.buf.hover, opts)
				vim.keymap.set("n", "gd", vim.lsp.buf.definition, opts)
				vim.keymap.set("n", "gD", vim.lsp.buf.declaration, opts)
				vim.keymap.set("n", "gi", vim.lsp.buf.implementation, opts)
				vim.keymap.set("n", "go", vim.lsp.buf.type_definition, opts)
				vim.keymap.set("n", "gr", vim.lsp.buf.references, opts)
				vim.keymap.set("n", "gs", vim.lsp.buf.signature_help, opts)
				vim.keymap.set("n", "gl", vim.diagnostic.open_float, opts) -- Show diagnostics float
				vim.keymap.set("n", "[d", vim.diagnostic.goto_prev, opts) -- Go to previous diagnostic
				vim.keymap.set("n", "]d", vim.diagnostic.goto_next, opts) -- Go to next diagnostic
				vim.keymap.set("n", "<leader>lr", vim.lsp.buf.rename, opts) -- LSP Rename
				vim.keymap.set({ "n", "v" }, "<leader>la", vim.lsp.buf.code_action, opts) -- LSP Code Action

				-- Formatting Keymap (Manual)
				vim.keymap.set({ "n", "v" }, "<leader>lf", function()
					vim.lsp.buf.format({ async = true, bufnr = event.buf })
				end, opts)

				-- Auto-formatting on Save (if client supports it and filetype matches)
				if client and client.supports_method("textDocument/formatting") then
					if vim.tbl_contains(autoformat_filetypes, vim.bo[event.buf].filetype) then
						vim.api.nvim_create_autocmd("BufWritePre", {
							buffer = event.buf,
							group = vim.api.nvim_create_augroup("LspFormatOnSave_" .. event.buf, { clear = true }), -- Use buffer-local augroup
							callback = function()
								vim.lsp.buf.format({ bufnr = event.buf, async = true })
							end,
						})
						-- vim.notify("Enabled format on save for " .. vim.bo[event.buf].filetype) -- Optional notification
					end
				end
			end,
		})

		-- Setup nvim-cmp (Autocompletion)
		local cmp = require("cmp")
		local luasnip = require("luasnip")
		require("luasnip.loaders.from_vscode").lazy_load() -- Load VSCode-style snippets

		vim.opt.completeopt = { "menu", "menuone", "noselect" } -- Set completion options

		cmp.setup({
			preselect = cmp.PreselectMode.Item, -- Preselect best match but don't auto-insert
			completion = {
				completeopt = "menu,menuone,noinsert", -- Options for completion command
			},
			window = {
				completion = cmp.config.window.bordered(),
				documentation = cmp.config.window.bordered(),
			},
			sources = cmp.config.sources({
				{ name = "nvim_lsp" },
				{ name = "luasnip" },
				{ name = "buffer", keyword_length = 3 },
				{ name = "path" },
			}),
			snippet = {
				expand = function(args)
					luasnip.lsp_expand(args.body)
				end,
			},
			formatting = {
				fields = { "abbr", "menu", "kind" },
				format = function(entry, item)
					-- Add icons or customize appearance here if desired
					-- local icons = require('lazyvim.config').icons.kinds -- Or your own icon config
					-- if icons and icons[item.kind] then
					--   item.kind = icons[item.kind] .. " " .. item.kind
					-- end
					item.menu = ({
						nvim_lsp = "[LSP]",
						luasnip = "[SNIP]",
						buffer = "[BUF]",
						path = "[PATH]",
					})[entry.source.name]
					return item
				end,
			},
			mapping = cmp.mapping.preset.insert({
				["<CR>"] = cmp.mapping.confirm({ select = false }), -- Confirm without selecting if no item selected
				["<C-Space>"] = cmp.mapping.complete(), -- Trigger completion
				["<C-e>"] = cmp.mapping.abort(), -- Close completion
				["<Tab>"] = cmp.mapping(function(fallback) -- Navigate or trigger completion/snippet
					if cmp.visible() then
						cmp.select_next_item({ behavior = cmp.SelectBehavior.Select })
					elseif luasnip.expand_or_jumpable() then
						luasnip.expand_or_jump()
					else
						fallback()
					end
				end, { "i", "s" }), -- Insert and Select mode
				["<S-Tab>"] = cmp.mapping(function(fallback) -- Navigate back
					if cmp.visible() then
						cmp.select_prev_item({ behavior = cmp.SelectBehavior.Select })
					elseif luasnip.jumpable(-1) then
						luasnip.jump(-1)
					else
						fallback()
					end
				end, { "i", "s" }),
				["<C-f>"] = cmp.mapping.scroll_docs(4),
				["<C-b>"] = cmp.mapping.scroll_docs(-4), -- Use C-b for back scroll
			}),
		})

		-- Setup DAP (Debugging)
		require("mason-tool-installer").setup({
			ensure_installed = {
				"codelldb", -- Install CodeLLDB DAP adapter for C++/Rust etc.
				-- "debugpy", -- Example: Python DAP adapter
			},
		})

		local dap = require("dap")
		-- local dapui = require('dapui') -- REMOVED UI require

		-- Configure CodeLLDB Adapter
		dap.adapters.codelldb = {
			type = "server",
			port = "${port}", -- Placeholder, nvim-dap replaces this
			executable = {
				-- Make sure codelldb is correctly installed by Mason or globally
				command = vim.fn.stdpath("data") .. "/mason/bin/codelldb", -- Use path from Mason
				args = { "--port", "${port}" },
				-- If you get errors about launching from restricted locations:
				-- detached = false,
			},
		}

		-- Configure DAP for Rust
		dap.configurations.rust = {
			{
				name = "Launch file (CodeLLDB)",
				type = "codelldb", -- MUST match the adapter name above
				request = "launch",
				program = function()
					-- Try to automatically find the executable in target/debug
					-- Assumes executable name matches the parent directory name
					local executable_path = vim.fn.getcwd()
						.. "/target/debug/"
						.. vim.fn.fnamemodify(vim.fn.getcwd(), ":t")
					if vim.fn.executable(executable_path) == 1 then
						return executable_path
					else
						-- Fallback: Prompt user if auto-detection fails
						return vim.fn.input("Path to executable: ", vim.fn.getcwd() .. "/target/debug/", "file")
					end
				end,
				cwd = "${workspaceFolder}", -- Run from the project root
				stopOnEntry = false, -- Don't stop at the program entry point
				sourceLanguages = { "rust" }, -- Specify the language
			},
			-- Add other configurations like attaching to a process if needed
		}

		-- DAP Keymaps
		vim.keymap.set("n", "<F5>", function()
			dap.continue()
		end, { desc = "DAP: Continue" })
		vim.keymap.set("n", "<F10>", function()
			dap.step_over()
		end, { desc = "DAP: Step Over" })
		vim.keymap.set("n", "<F11>", function()
			dap.step_into()
		end, { desc = "DAP: Step Into" })
		vim.keymap.set("n", "<F12>", function()
			dap.step_out()
		end, { desc = "DAP: Step Out" })
		vim.keymap.set("n", "<leader>b", function()
			dap.toggle_breakpoint()
		end, { desc = "DAP: Toggle Breakpoint" })
		vim.keymap.set("n", "<leader>B", function() -- Conditional breakpoint
			dap.set_breakpoint(vim.fn.input("Breakpoint condition: "))
		end, { desc = "DAP: Set Conditional Breakpoint" })
		vim.keymap.set("n", "<leader>lp", function() -- Log point
			dap.set_breakpoint(nil, nil, vim.fn.input("Log point message: "))
		end, { desc = "DAP: Set Log Point" })
		vim.keymap.set("n", "<leader>dr", function()
			dap.repl.open()
		end, { desc = "DAP: Open REPL" })
		vim.keymap.set("n", "<leader>dl", function()
			dap.run_last()
		end, { desc = "DAP: Run Last" })
		-- vim.keymap.set('n', '<leader>du', function() dapui.toggle() end, { desc = "DAP: Toggle UI" }) -- REMOVED UI keymap
		vim.keymap.set("n", "<leader>dt", function()
			dap.terminate()
		end, { desc = "DAP: Terminate" })

		-- Automatically open DAP UI when debugging starts and close when it ends -- REMOVED UI listeners
		-- dap.listeners.after.event_initialized["dapui_config"] = function()
		--   dapui.open()
		-- end
		-- dap.listeners.before.event_terminated["dapui_config"] = function()
		--   dapui.close()
		-- end
		-- dap.listeners.before.event_exited["dapui_config"] = function()
		--   dapui.close()
		-- end
	end,
}
