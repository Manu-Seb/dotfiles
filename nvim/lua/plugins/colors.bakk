return {
  { import = "lazyvim.plugins.colorscheme" },

  {
    "folke/tokyonight.nvim",
    lazy = false,
    priority = 1000,
    opts = {
      style = "storm",
      transparent = true,
    },
    config = function(_, opts)
      require("tokyonight").setup(opts)
      vim.cmd("colorscheme tokyonight")

      local function set(name, val)
        vim.api.nvim_set_hl(0, name, val)
      end
      set("Normal", { bg = "#000000" })
      set("NormalNC", { bg = "#000000" })
      set("NormalFloat", { bg = "#000000" })
      set("FloatBorder", { bg = "#000000", fg = "#565f89" })
    end,
  },
  {
    "nvim-lualine/lualine.nvim",
    dependencies = { "nvim-tree/nvim-web-devicons" },
    config = function()
      require("lualine").setup({
        options = {
          theme = "tokyonight",  -- ✅ Fixed: matches colorscheme
          section_separators = "",
          component_separators = "",
          icons_enabled = true,
        },
        sections = {
          lualine_a = { "mode" },
          lualine_b = { "branch", "diff", "diagnostics" },
          lualine_c = { "filename" },
          lualine_x = { "filetype" },
          lualine_y = { "progress" },
          lualine_z = { "location" },
        },
      })
    end,
  },
}
